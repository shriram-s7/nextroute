{
  "name": "nextroute",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NextRoute — Adaptive dispatch for Chennai buses (simulation prototype)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:validate": "node --max-old-space-size=4096 scripts/gtfs-validate.mjs data/gtfs-raw data/validation-report.json",
    "data:build": "node --max-old-space-size=4096 scripts/build-corridor.mjs data/gtfs-raw src/data/corridor.json",
    "train": "tsx scripts/train-forecast.ts",
    "batch": "tsx scripts/batch.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/mapbox": "^9.4.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "mapbox-gl": "^3.35.0",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
